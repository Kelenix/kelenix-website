generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      UserRole @default(EDITOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pushSubscriptions PushSubscription[]

  @@map("users")
}

// Appareil (navigateur ou téléphone) d'un administrateur abonné aux notifications push.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  MODERATOR
}

model Service {
  id               String   @id @default(cuid())
  slug             String   @unique
  titleFr          String
  titleEn          String
  shortDescFr      String   @db.Text
  shortDescEn      String   @db.Text
  longDescFr       String   @db.Text
  longDescEn       String   @db.Text
  icon             String
  image            String?
  technologies     String   @db.Text
  faqFr            String   @db.Text
  faqEn            String   @db.Text
  order            Int      @default(0)
  published        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("services")
}

model Faq {
  id         String   @id @default(cuid())
  category   String   // services | pricing | process | delays | support
  questionFr String   @db.Text
  questionEn String   @db.Text
  answerFr   String   @db.Text
  answerEn   String   @db.Text
  order      Int      @default(0)
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("faqs")
}

model Project {
  id           String        @id @default(cuid())
  slug         String        @unique
  titleFr      String
  titleEn      String
  client       String
  category     ProjectCategory
  descFr       String        @db.Text
  descEn       String        @db.Text
  problemFr    String        @db.Text
  problemEn    String        @db.Text
  solutionFr   String        @db.Text
  solutionEn   String        @db.Text
  resultsFr    String        @db.Text
  resultsEn    String        @db.Text
  technologies String        @db.Text
  coverImage   String
  gallery      String        @db.Text
  link         String?
  featured     Boolean       @default(false)
  published    Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("projects")
}

enum ProjectCategory {
  WEB
  MOBILE
  AI
  SOFTWARE
  CONSULTING
  TRAINING
}

model BlogPost {
  id          String      @id @default(cuid())
  slug        String      @unique
  titleFr     String
  titleEn     String
  contentFr   String      @db.Text
  contentEn   String      @db.Text
  excerptFr   String      @db.Text
  excerptEn   String      @db.Text
  coverImage  String?
  authorName  String
  authorImage String?
  authorBio   String?     @db.Text
  category    BlogCategory
  tags        String      @db.Text
  published   Boolean     @default(false)
  publishedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("blog_posts")
}

enum BlogCategory {
  DEVELOPMENT
  AI
  DIGITAL
  NEWS
  GUIDES
}

model Testimonial {
  id          String   @id @default(cuid())
  name        String
  company     String
  position    String
  photo       String?
  textFr      String   @db.Text
  textEn      String   @db.Text
  rating      Int      @default(5)
  showOnHome  Boolean  @default(false)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("testimonials")
}

model ContactMessage {
  id        String        @id @default(cuid())
  firstName String
  lastName  String
  email     String
  phone     String?
  company   String?
  service   String?
  budget    String?
  message   String        @db.Text
  attachment String?
  status    MessageStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("contact_messages")
}

model QuoteRequest {
  id           String        @id @default(cuid())
  serviceType  String
  projectName  String
  projectDesc  String        @db.Text
  projectGoals String?       @db.Text
  budget       String
  deadline     String
  firstName    String
  lastName     String
  email        String
  phone        String?
  company      String?
  // "form" : formulaire de devis. "assistant" : demande recueillie par l'assistant IA.
  source       String        @default("form")
  status       MessageStatus @default(NEW)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("quote_requests")
}

// Conversation d'un visiteur avec l'assistant IA du site.
// `tenant` désigne l'entreprise servie : l'assistant est conçu pour en servir plusieurs.
model AgentConversation {
  // Identifiant aléatoire fourni par le serveur : le connaître suffit à reprendre la conversation.
  id        String   @id
  tenant    String
  locale    String
  // Consignes figées à l'ouverture : l'API exige un début de conversation identique d'un tour à l'autre.
  system    String   @db.Text
  // Historique complet au format de l'API (tours du visiteur et de l'assistant).
  messages  Json
  turns     Int      @default(0)
  // Demande de devis créée par l'assistant pendant cette conversation.
  quoteId   String?
  page      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenant, createdAt])
  @@map("agent_conversations")
}

// Entreprise à prospecter, et l'e-mail que l'agent sortant a préparé pour elle.
// Rien ne part tout seul : un membre de l'équipe relit le brouillon et l'envoie depuis sa messagerie.
model Prospect {
  id          String         @id @default(cuid())
  tenant      String
  company     String
  website     String?
  contactName String?
  email       String?
  // Langue de l'e-mail : fr, it ou en.
  language    String         @default("fr")
  // Ce que l'équipe sait déjà (contexte, angle souhaité) : donné à l'agent avec le site.
  notes       String?        @db.Text
  status      ProspectStatus @default(NEW)
  // Produit par l'agent : ce qu'il a compris de l'entreprise, la raison de la contacter, le brouillon.
  summary     String?        @db.Text
  angle       String?        @db.Text
  // Adresse de contact lue sur le site, proposée quand `email` est vide.
  emailFound  String?
  subject     String?
  body        String?        @db.Text
  // Raison du dernier échec de préparation.
  error       String?        @db.Text
  sentAt      DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([tenant, createdAt])
  @@map("prospects")
}

enum ProspectStatus {
  NEW
  PREPARING
  READY
  FAILED
  SENT
  REPLIED
  DECLINED
  DO_NOT_CONTACT
}

enum MessageStatus {
  NEW
  READ
  IN_PROGRESS
  TREATED
  ARCHIVED
}

model Newsletter {
  id          String   @id @default(cuid())
  email       String   @unique
  active      Boolean  @default(true)
  subscribedAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

model SiteSettings {
  id           String   @id @default(cuid())
  key          String   @unique
  value        String   @db.Text
  updatedAt    DateTime @updatedAt

  @@map("site_settings")
}

model JobPosting {
  id          String   @id @default(cuid())
  titleFr     String
  titleEn     String
  descFr      String   @db.Text
  descEn      String   @db.Text
  location    String
  contractType String
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("job_postings")
}

model PartnerRequest {
  id          String   @id @default(cuid())
  company     String
  name        String
  email       String
  phone       String?
  partnerType String
  message     String   @db.Text
  status      MessageStatus @default(NEW)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("partner_requests")
}

model JobApplication {
  id          String        @id @default(cuid())
  name        String
  email       String
  phone       String?
  position    String?
  message     String        @db.Text
  cvPath      String?
  status      MessageStatus @default(NEW)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("job_applications")
}

model MobileApp {
  id        String   @id @default(cuid())
  name      String
  initial   String
  color     String
  category  String
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("mobile_apps")
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  roleFr    String
  roleEn    String
  bioFr     String   @db.Text
  bioEn     String   @db.Text
  avatar    String?
  linkedin  String?
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("team_members")
}

model AboutTimeline {
  id        String   @id @default(cuid())
  year      String
  titleFr   String
  titleEn   String
  descFr    String   @db.Text
  descEn    String   @db.Text
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("about_timeline")
}

model WhyPoint {
  id        String   @id @default(cuid())
  icon      String
  titleFr   String
  titleEn   String
  descFr    String   @db.Text
  descEn    String   @db.Text
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("why_points")
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  userEmail String
  action    String
  resource  String
  details   String?  @db.Text
  createdAt DateTime @default(now())

  @@map("activity_logs")
}
